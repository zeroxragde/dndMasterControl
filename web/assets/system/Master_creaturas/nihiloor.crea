  "Reacciones": [],
  "HechizosOEspeciales": [
    {
      "Nombre": "Lanzamiento de Conjuros Innato (Psiónicos)",
      "Descripcion": "La característica para lanzar hechizos de Nihiloor es Inteligencia (salvación de hechizo DC 15). Puede lanzar los siguientes hechizos sin componentes: \nA voluntad: Detectar Pensamientos, Levitar. \n1/día cada uno: Dominar Monstruo, Sugestión, Desplazamiento de Plano (solo a sí mismo)."
    }
